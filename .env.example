# Скопируйте этот файл в .env и заполните значениями из Supabase:
# Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Необязательно: принудительно включить демо-режим без Supabase (true/false).
# Если переменные Supabase не заданы, демо-режим включается автоматически.
VITE_DEMO_MODE=false

# Необязательно: резервное имя дисциплины по умолчанию.
# Обычно используется название выбранной дисциплины.
VITE_SUBJECT_NAME=Учебная дисциплина

# Необязательно (этап 9): URL ONLYOFFICE Document Server.
# Если не задан — кнопка онлайн-редактирования Office-файлов скрыта.
VITE_ENABLE_EDITING=false
VITE_ONLYOFFICE_URL=
